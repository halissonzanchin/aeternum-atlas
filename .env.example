VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server/local tooling only. Never expose this key in the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Edge Function secrets are configured in Supabase, never in Vite/Vercel client variables:
# GEMINI_API_KEY=AIza...
# VITA_GEMINI_MODEL=gemini-2.5-flash-lite
# VITA_INFERENCE_LLM_MODEL=google/gemma-4-31b-it
# AETERNUM_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173

# Public browser switch. Use "off" to disable Vita voice without falling back
# to the legacy browser engine. Provider credentials must never use VITE_*.
VITE_AETERNUM_VITA_PIPELINE=livekit
VITE_LIVEKIT_AGENT_NAME=aeternum-vita-voice

# Server/Edge Function secrets only (Supabase secret store and agent runtime):
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
# LIVEKIT_AGENT_NAME=aeternum-vita-voice
# DEEPGRAM_API_KEY=...
# CARTESIA_API_KEY=...
