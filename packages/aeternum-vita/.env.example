# LiveKit Community. Gere valores aleatórios; não reutilize credenciais expostas.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=replace-with-random-key
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
LIVEKIT_AGENT_NAME=aeternum-vita-voice

# Inferência local sem créditos de API.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_TEMPERATURE=0.25
LOCAL_SPEECH_BASE_URL=http://localhost:8000/v1
LOCAL_SPEECH_API_KEY=replace-with-random-internal-key
LOCAL_STT_MODEL=Systran/faster-whisper-small
LOCAL_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
LOCAL_TTS_MODEL_DE=speaches-ai/piper-de_DE-thorsten-high
LOCAL_TTS_VOICE_EDUARDO=pm_alex
LOCAL_TTS_VOICE_ANTONIA=ef_dora
LOCAL_TTS_VOICE_ARIANA=af_heart
LOCAL_TTS_VOICE_FABIAN=thorsten
LOCAL_TTS_SPEED=1

# API de busca exclusiva da Aeternum Vita. Não aponte para o cérebro da Atlas IA.
VITA_RAG_URL=
VITA_RAG_API_KEY=
VITA_RAG_TIMEOUT_MS=2500

# Token server e frontend local.
TOKEN_SERVER_PORT=3001
WEB_ORIGIN=http://localhost:8080

# Supabase da Aeternum Vita; use secret key somente no servidor.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-secret-key
VOICE_ALLOWED_ORIGIN=https://www.aeternumatlas.com
VOICE_ALLOW_GUESTS=false
