{
  "name": "aeternum-vita",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @aeternum-vita/web --filter @aeternum-vita/token-server --parallel --stream dev",
    "dev:all": "pnpm --recursive --parallel --stream dev",
    "dev:agent": "pnpm --filter @aeternum-vita/agent dev",
    "dev:token": "pnpm --filter @aeternum-vita/token-server dev",
    "dev:web": "pnpm --filter @aeternum-vita/web dev",
    "build": "pnpm --recursive --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.8.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@livekit/protocol": "^1.50.4",
    "livekit-server-sdk": "^2.18.0",
    "zod": "^4.4.3"
  }
}
