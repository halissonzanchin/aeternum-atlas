# =====================================================================
# Aeternum Atlas — Staging Runtime Environment Contract (.env.staging.example)
# Target Environment: Vercel Staging
# Supabase Staging Reference: hutohshswppahipgcwio
# =====================================================================

# Public Client Variables (Bundled into frontend client build)
# ---------------------------------------------------------------------
# Supabase Staging Project Gateway URL
VITE_SUPABASE_URL=https://hutohshswppahipgcwio.supabase.co

# Supabase Staging Anonymous / Publishable Key (Safe for browser distribution)
VITE_SUPABASE_ANON_KEY=your-staging-anon-key-here

# Atlas AI Tutor Operating Mode:
# 'standby' = Displays institutional maintenance message; prevents 503 and blocks localhost calls
# 'active'  = Connects to Supabase Edge Function ai-tutor
VITE_ATLAS_AI_MODE=standby

# Aeternum Vita Neural Voice Pipeline:
# 'off'     = Disables LiveKit voice pipeline safely without connecting to WebSockets
# 'livekit' = Enables LiveKit room connection via authenticated voice-token function
VITE_AETERNUM_VITA_PIPELINE=off

# Optional voice agent identifier when livekit pipeline is active
VITE_LIVEKIT_AGENT_NAME=aeternum-vita-voice

# Explicitly ensure runtime is not set to local
VITE_ATLAS_RUNTIME=cloud

# ---------------------------------------------------------------------
# Edge Function & Backend Secrets (NEVER expose to Vite/Vercel Client)
# Configure these directly in Supabase Dashboard (Project Settings > Edge Functions Secrets)
# ---------------------------------------------------------------------
# GEMINI_API_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
# LIVEKIT_URL=...
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
